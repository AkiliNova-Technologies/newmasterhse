# =============================================================================
# Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.

# --- Sanity (published public content, read-only) ---
# Project and production dataset created for NewMaster. These are intentionally
# public values. Do not add a Sanity write token to this application.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=your-sanity-dataset

# --- Resend (contact form email delivery) ---
# Required: API key from https://resend.com/api-keys
RESEND_API_KEY=

# Required: The inbox address that receives website enquiry emails.
CONTACT_EMAIL=

# Required: A Resend-verified sender address.
RESEND_FROM_EMAIL=
